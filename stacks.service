# 枚数検知監視 stacks_v2_7_2.py の systemd ユニット
#
# ラズパイへの導入手順:
#   1. このリポジトリをクローン／pull したディレクトリに合わせて
#      WorkingDirectory と ExecStart のパスを必要なら修正する
#   2. 配置・有効化:
#        sudo cp stacks.service /etc/systemd/system/stacks.service
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now stacks.service
#   3. 確認:
#        sudo systemctl status stacks.service
#        journalctl -u stacks.service -f
#
# 注意:
#   - User= は実機のユーザー名に合わせる（コード内 LOG_DIR も /home/<user>/...）
#   - プロセス起動後も監視は OFF（赤LED）。ボタン①で監視開始

[Unit]
Description=Senbei stack count monitor (stacks_v2_7_2)
After=multi-user.target

[Service]
Type=simple
User=raspai
WorkingDirectory=/home/raspai/Desktop
ExecStart=/usr/bin/python3 /home/raspai/Desktop/stacks_v2_7_2.py
Restart=on-failure
RestartSec=3

# gpiozero / GPIO アクセス用（ユーザーが gpio グループに入っている前提）
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
